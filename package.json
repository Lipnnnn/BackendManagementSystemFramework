{
  "name": "asset-entry-tool",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "author": "Your Name",
  "description": "网络安全协调指挥平台-资产填报工具",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "build:go": "vue-tsc -b && vite build && go build -ldflags=\"-s -w -H windowsgui\" -trimpath -o release-go/资产填报工具.exe server.go"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "ant-design-vue": "~4.2.6",
    "dayjs": "^1.11.19",
    "jszip": "^3.10.1",
    "vue": "^3.5.24",
    "vue-router": "^4.6.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/jszip": "^3.4.1",
    "@types/node": "^24.10.1",
    "@unocss/preset-attributify": "^66.5.9",
    "@unocss/preset-uno": "^66.5.9",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "electron": "^39.2.4",
    "electron-builder": "^26.0.12",
    "electron-packager": "^17.1.2",
    "pkg": "^5.8.1",
    "typescript": "~5.9.3",
    "unocss": "^66.5.9",
    "vite": "^7.2.4",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vue-tsc": "^3.1.4"
  },
  "build": {
    "appId": "com.cybersecurity.asset-tool",
    "productName": "网络安全协调指挥平台-资产填报工具",
    "electronDownload": {
      "cache": "node_modules/.cache/electron"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist",
      "dist-electron"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "资产填报工具"
    },
    "portable": {
      "artifactName": "${productName}-便携版.exe"
    }
  }
}
